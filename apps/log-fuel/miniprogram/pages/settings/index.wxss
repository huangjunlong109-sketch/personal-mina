.container {
  box-sizing: border-box;
  background: #F4F5F9;
  min-height: 100vh;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(112rpx + constant(safe-area-inset-bottom));
}
.section { background: #fff; border-radius: 20rpx; margin: 20rpx 24rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; gap: 20rpx; }
.menu-icon { font-size: 36rpx; }
.menu-text { flex: 1; font-size: 30rpx; color: #1C1C3A; }
.menu-arrow { color: #C0C0CC; font-size: 36rpx; }
.version { text-align: center; color: #C0C0CC; font-size: 24rpx; margin-top: 40rpx; }
