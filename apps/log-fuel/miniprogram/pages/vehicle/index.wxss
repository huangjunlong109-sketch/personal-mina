.container { background: #F4F5F9; min-height: 100vh; }
.section { background: #fff; border-radius: 20rpx; margin: 24rpx; overflow: hidden; }
.field { display: flex; align-items: center; padding: 28rpx; gap: 20rpx; }
.label { font-size: 28rpx; color: #1C1C3A; width: 120rpx; flex-shrink: 0; }
.req { color: #FF3B30; }
.input { flex: 1; font-size: 28rpx; color: #1C1C3A; text-align: right; }
.divider { height: 1rpx; background: #EBEBF0; margin: 0 28rpx; }
.btn-save { margin: 32rpx 24rpx; height: 96rpx; background: #6B7FC2; border-radius: 56rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; font-weight: 600; }
.btn-save.disabled { opacity: 0.6; }
