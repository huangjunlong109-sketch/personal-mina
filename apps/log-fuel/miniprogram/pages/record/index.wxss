.container {
  min-height: 100vh;
  background: #F5F6FB;
  box-sizing: border-box;
}

.custom-nav {
  background: linear-gradient(180deg, #8090C0 0%, #7D8CC8 100%);
  box-shadow: 0 6rpx 18rpx rgba(73, 86, 137, 0.08);
}

.custom-nav-status {
  width: 100%;
}

.custom-nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.custom-nav-side {
  height: 100%;
  display: flex;
  align-items: center;
}

.custom-nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-back-icon {
  font-size: 56rpx;
  line-height: 1;
  color: #FFFFFF;
  margin-top: -6rpx;
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.form-body {
  padding: 20rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}

.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(58, 68, 106, 0.05);
}

.section--compact {
  padding: 0 28rpx;
}

.section--amount {
  padding: 22rpx 20rpx 24rpx;
}

.section--field {
  padding: 24rpx 28rpx 28rpx;
}

.vehicle-card {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-right {
  display: flex;
  align-items: center;
  max-width: 58%;
}

.vehicle-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F1F3F8;
  color: #7B88C8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.vehicle-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C3A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vehicle-text.warn { color: #FF9500; }

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
}

.row-label {
  font-size: 28rpx;
  color: #1C1C3A;
  font-weight: 500;
}

.required { color: #FF3B30; }

.row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.row-value {
  font-size: 28rpx;
  color: #4F556B;
  font-weight: 600;
}

.row-arrow {
  color: #C9CDD8;
  font-size: 30rpx;
}

.divider {
  height: 1rpx;
  background: #EEF1F6;
}

.amount-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.amount-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.amount-label {
  font-size: 22rpx;
  color: #8C8CA0;
  margin-bottom: 12rpx;
  white-space: nowrap;
  text-align: center;
}

.amount-input-wrap {
  height: 86rpx;
  border: 2rpx solid #E1E5EE;
  border-radius: 12rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-input {
  width: 100%;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C3A;
  padding: 0 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.amount-placeholder {
  color: #C8CDD9;
  font-weight: 600;
}

.amount-eq {
  font-size: 28rpx;
  color: #C0C0CC;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.odometer-block {
  display: flex;
  flex-direction: column;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-hint {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8C8CA0;
  line-height: 1;
}

.odometer-input-wrap {
  margin-top: 18rpx;
  border: 2rpx solid #E1E5EE;
  border-radius: 12rpx;
  background: #FCFCFE;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.odometer-input {
  height: 92rpx;
  padding: 0 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1C1C3A;
  width: 100%;
  box-sizing: border-box;
}

.odometer-placeholder {
  color: #C8CDD9;
  font-size: 26rpx;
  font-weight: 500;
}

.segment-control {
  display: flex;
  background: #F3F5FA;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 18rpx;
}

.segment-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8C8CA0;
  border-radius: 10rpx;
}

.segment-item.active {
  background: #7488D4;
  color: #FFFFFF;
  font-weight: 600;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 246, 251, 0) 0%, #F5F6FB 28%, #F5F6FB 100%);
  box-sizing: border-box;
}

.btn-save {
  height: 96rpx;
  background: #7488D4;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(116, 136, 212, 0.18);
}

.btn-save.disabled { opacity: 0.6; }
