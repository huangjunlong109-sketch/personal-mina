.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  box-shadow: 0 -1rpx 0 #EEEEEE;
  z-index: 100;
  overflow: visible;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
  height: 100rpx;
  gap: 4rpx;
}

.tab-label {
  font-size: 20rpx;
  color: #999999;
  line-height: 1;
}

.tab-item.active .tab-label {
  color: #FFD000;
}

/* 图标 - 用CSS绘制简单线条图标 */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 明细图标：竖线列表 */
.icon-ledger {
  width: 36rpx;
  height: 30rpx;
  border: 3rpx solid #999999;
  border-radius: 4rpx;
  position: relative;
}
.icon-ledger::before,
.icon-ledger::after {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: #999999;
  border-radius: 2rpx;
}
.icon-ledger::before { top: 6rpx; }
.icon-ledger::after { top: 14rpx; }

.icon-ledger.icon-active {
  border-color: #FFD000;
}
.icon-ledger.icon-active::before,
.icon-ledger.icon-active::after {
  background: #FFD000;
}

/* 图表图标：柱状图 */
.icon-chart {
  width: 36rpx;
  height: 30rpx;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  padding: 0 2rpx;
}
.icon-chart::before,
.icon-chart::after {
  content: '';
  flex: 1;
  background: #999999;
  border-radius: 2rpx 2rpx 0 0;
}
.icon-chart::before { height: 60%; }
.icon-chart::after { height: 100%; }

.icon-chart.icon-active::before,
.icon-chart.icon-active::after {
  background: #FFD000;
}

/* 账单：折角纸 */
.icon-bill {
  width: 28rpx;
  height: 34rpx;
  border: 3rpx solid #999999;
  border-radius: 4rpx;
  position: relative;
  box-sizing: border-box;
}
.icon-bill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  border-width: 0 10rpx 10rpx 0;
  border-style: solid;
  border-color: transparent #999999 transparent transparent;
}
.icon-bill.icon-active {
  border-color: #FFD000;
}
.icon-bill.icon-active::after {
  border-right-color: #FFD000;
}

/* 个人图标 */
.icon-profile {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid #999999;
}
.icon-profile.icon-active {
  border-color: #FFD000;
}

/* 中间记账按钮 */
.tab-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 10rpx;
  height: 120rpx;
  gap: 4rpx;
}

.tab-add-btn {
  width: 100rpx;
  height: 100rpx;
  background: #FFD000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 208, 0, 0.5);
}

.tab-add-plus {
  font-size: 60rpx;
  color: #FFFFFF;
  line-height: 1;
  margin-top: -4rpx;
}

.tab-label-center {
  color: #FFD000;
  font-weight: 500;
}
