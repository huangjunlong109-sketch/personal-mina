.record-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

/* 类型 Tab */
.type-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: #FFD000;
  position: relative;
}

.type-tab {
  padding: 12rpx 40rpx;
  font-size: 32rpx;
  color: rgba(0,0,0,0.5);
  font-weight: 500;
  border-radius: 32rpx;
  transition: all 0.2s;
}

.type-tab--active {
  background: rgba(0,0,0,0.12);
  color: #000000;
}

.type-cancel {
  position: absolute;
  right: 30rpx;
  font-size: 30rpx;
  color: rgba(0,0,0,0.6);
}

/* 分类网格 */
.category-scroll {
  flex: 1;
  overflow: hidden;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 20rpx 16rpx;
  gap: 8rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  gap: 10rpx;
  border-radius: 12rpx;
}

.category-item--active {
  background: rgba(255, 208, 0, 0.15);
}

.category-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon-wrap--active {
  background: #FFD000;
}

.category-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.category-name {
  font-size: 22rpx;
  color: #333333;
  text-align: center;
}

/* 金额 + 备注 */
.amount-area {
  border-top: 1rpx solid #EEEEEE;
  padding: 16rpx 24rpx;
}

.amount-note-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.note-input {
  flex: 1;
  font-size: 26rpx;
  color: #999999;
  min-height: 60rpx;
}

.note-placeholder {
  color: #BBBBBB;
}

.amount-display {
  font-size: 52rpx;
  font-weight: 600;
  color: #333333;
  min-width: 160rpx;
  text-align: right;
}

/* 键盘：等分四列，picker 需单独占一列否则 flex 会错位 */
.keyboard {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: #E5E5E5;
  padding-bottom: env(safe-area-inset-bottom);
}

.keyboard-row {
  display: flex;
  flex-direction: row;
  gap: 1rpx;
}

.keyboard-row > .key,
.key-picker {
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
}

.key-picker {
  display: block;
}

.key-picker .key {
  width: 100%;
  box-sizing: border-box;
}

.key {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333333;
  background: #FFFFFF;
  font-weight: 400;
}

.key:active {
  background: #F0F0F0;
}

.key-func {
  background: #EEEEEE;
  font-size: 36rpx;
}

.key-date {
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 0 8rpx;
  gap: 4rpx;
}

.key-date-icon {
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.key-date-text {
  font-size: 22rpx;
  color: #666666;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.key-done {
  background: #CCCCCC;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.key-done--active {
  background: #FFD000;
  color: #FFFFFF;
}
