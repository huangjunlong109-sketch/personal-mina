.chart-records-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

.top-panel {
  background: #FFD000;
  padding: 18rpx 24rpx 20rpx;
}

.view-tabs {
  display: flex;
  border: 1rpx solid rgba(51, 51, 51, 0.8);
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.view-tab {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  line-height: 72rpx;
  color: #333333;
  border-right: 1rpx solid rgba(51, 51, 51, 0.8);
}

.view-tab:last-child {
  border-right: none;
}

.view-tab--active {
  background: #353131;
  color: #FFE36B;
  font-weight: 600;
}

.period-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 6rpx 0;
}

.period-nav-btn {
  width: 52rpx;
  text-align: center;
  font-size: 40rpx;
  line-height: 1;
  color: #333333;
}

.period-nav-btn--disabled {
  color: rgba(51, 51, 51, 0.24);
}

.period-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.period-title {
  font-size: 34rpx;
  color: #333333;
  font-weight: 600;
}

.period-indicator {
  width: 48rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #333333;
}

.page-scroll {
  flex: 1;
  overflow: hidden;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.summary-card {
  background: #FFFFFF;
  padding: 28rpx 30rpx 30rpx;
}

.summary-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.category-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-emoji {
  font-size: 36rpx;
}

.summary-head-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.summary-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.summary-period {
  font-size: 24rpx;
  color: #999999;
}

.summary-metrics {
  display: flex;
  gap: 86rpx;
}

.metric-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.metric-label {
  font-size: 24rpx;
  color: #999999;
}

.metric-value {
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #333333;
}

.metric-value--small {
  font-size: 42rpx;
}

.chart-card {
  position: relative;
  background: #FFFFFF;
  padding: 18rpx 20rpx 0;
  margin-top: 2rpx;
}

.chart-max {
  position: absolute;
  right: 28rpx;
  top: 18rpx;
  font-size: 20rpx;
  color: #666666;
  z-index: 1;
}

.line-chart {
  width: 100%;
  height: 320rpx;
  display: block;
}

.chart-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: #BBBBBB;
}

.chart-x-labels {
  background: #FFFFFF;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 18rpx 18rpx;
}

.x-label {
  flex: 1;
  font-size: 20rpx;
  color: #999999;
  text-align: center;
}

.list-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.rank-section {
  background: #FFFFFF;
  margin-top: 16rpx;
  padding: 30rpx 30rpx 12rpx;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.rank-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.sort-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
}

.sort-tab {
  min-width: 112rpx;
  padding: 12rpx 18rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.sort-tab--active {
  background: #FFFFFF;
  color: #333333;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.rank-list {
  display: flex;
  flex-direction: column;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0 28rpx;
}

.rank-item--hover {
  opacity: 0.76;
}

.rank-item-left {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.rank-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.rank-emoji {
  font-size: 34rpx;
}

.rank-item-info {
  flex: 1;
}

.rank-item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.rank-item-name {
  max-width: 60%;
  font-size: 34rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.2;
}

.rank-item-percent {
  font-size: 22rpx;
  color: #666666;
}

.rank-bar-wrap {
  width: 100%;
  height: 12rpx;
  background: #F1F1F1;
  border-radius: 6rpx;
  overflow: hidden;
}

.rank-bar {
  height: 100%;
  background: #FFD000;
  border-radius: 6rpx;
  max-width: 100%;
}

.rank-item-date,
.rank-item-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.3;
}

.rank-item-amount {
  min-width: 120rpx;
  font-size: 34rpx;
  color: #333333;
  font-weight: 500;
  text-align: right;
  flex-shrink: 0;
}
