.category-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

.type-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #999999;
  position: relative;
}

.type-tab--active {
  color: #333333;
  font-weight: 600;
}

.type-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: #FFD000;
  border-radius: 2rpx;
}

.cat-scroll {
  flex: 1;
  overflow: hidden;
}

.section-header {
  padding: 24rpx 30rpx 8rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999999;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8rpx 16rpx 16rpx;
  gap: 8rpx;
  background: #FFFFFF;
  margin: 0 0 2rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  gap: 10rpx;
  position: relative;
}

.cat-item--hidden {
  opacity: 0.4;
}

.cat-item--tap:active {
  opacity: 0.85;
}

.cat-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-icon-add {
  background: #FFF8D0;
  border: 2rpx dashed #FFD000;
}

.cat-add-plus {
  font-size: 44rpx;
  color: #FFD000;
  line-height: 1;
  margin-top: -4rpx;
}

.cat-emoji {
  font-size: 38rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #333333;
  text-align: center;
}

/* 隐藏/显示 按钮（右上角小圆标） */
.cat-hide-btn,
.cat-show-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

.cat-show-btn {
  background: #FFD000;
  color: #FFFFFF;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.modal-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 600rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

.modal-box--tall {
  max-height: 85vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.modal-input {
  border: 1rpx solid #EEEEEE;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333333;
}

.modal-label {
  font-size: 26rpx;
  color: #666666;
  align-self: flex-start;
}

.modal-icon-scroll {
  height: 440rpx;
  width: 100%;
}

.modal-icon-group {
  margin-bottom: 20rpx;
}

.modal-group-title {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.modal-icon-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.modal-icon-item {
  height: 76rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.modal-icon-item--active {
  border-color: #FFD000;
  background: #FFF8D0;
}

.modal-icon-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-btn-cancel {
  background: #F5F5F5;
  color: #999999;
}

.modal-btn-confirm {
  background: #FFD000;
  color: #333333;
  font-weight: 600;
}
