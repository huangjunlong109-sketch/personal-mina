<view class="profile-page">
  <!-- 用户信息 -->
  <view class="user-card">
    <image class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" />
    <text class="user-name">{{nickName}}</text>
  </view>

  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 功能设置 -->
    <view class="section">
      <text class="section-title">功能设置</text>
      <view class="menu-card">
        <view class="menu-item" bindtap="goCategory">
          <text class="menu-icon">🏷️</text>
          <text class="menu-label">类别设置</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-divider"></view>

        <!-- 每月开始于 -->
        <view class="menu-item">
          <text class="menu-icon">🗓️</text>
          <text class="menu-label">每月开始于</text>
          <view class="menu-right">
            <picker
              mode="selector"
              range="{{cycleDayOptions}}"
              value="{{cycleDayIndex}}"
              bindchange="onCycleDayChange"
            >
              <view class="menu-picker-val">
                <text>{{cycleDayOptions[cycleDayIndex]}}</text>
                <text class="menu-arrow">›</text>
              </view>
            </picker>
          </view>
        </view>
        <view class="menu-divider"></view>

        <!-- 默认记账类型 -->
        <view class="menu-item">
          <text class="menu-icon">📝</text>
          <text class="menu-label">默认记账类型</text>
          <view class="menu-right">
            <picker
              mode="selector"
              range="{{defaultTypeOptions}}"
              value="{{defaultTypeIndex}}"
              bindchange="onDefaultTypeChange"
            >
              <view class="menu-picker-val">
                <text>{{defaultTypeOptions[defaultTypeIndex]}}</text>
                <text class="menu-arrow">›</text>
              </view>
            </picker>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据安全 -->
    <view class="section">
      <text class="section-title">数据安全</text>
      <view class="menu-card">
        <view class="menu-item" bindtap="exportData">
          <text class="menu-icon">📤</text>
          <text class="menu-label">导出数据</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section">
      <view class="menu-card">
        <view class="menu-item">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-label">关于 LoG记账</text>
          <text class="menu-value">{{versionText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
